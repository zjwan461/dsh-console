# Copy to scripts/.remote.env (git-ignored) and fill in your own host.
# These scripts talk to a REMOTE Docker daemon and the deployed console; nothing
# here is committed, and every value below is an example.

# Docker daemon reachable over TCP (no TLS in this example). Prefer a private
# network or an SSH tunnel; never expose :2375 to the internet.
DSH_REMOTE_DOCKER=http://10.0.0.10:2375

# How the console and API are reachable from where you run the scripts.
DSH_CONSOLE_URL=http://10.0.0.10:38080
DSH_API_URL=http://10.0.0.10:38000/api/v1

# Admin credentials used by the regression scripts.
DSH_ADMIN_USER=admin
DSH_ADMIN_PASSWORD=change-me

# Absolute path of the data directory **on the Docker host** (bind mount source).
DSH_HOST_DATA_ROOT=/opt/dsh-console/data

# MySQL DSN used by the api container.
DSH_MYSQL_DSN=mysql+pymysql://dsh:change-me@10.0.0.20:3306/dsh_console?charset=utf8mb4

# Redis used by the api/worker containers (alias on the console network).
DSH_REDIS_URL=redis://redis:6379/0

# Placeholder base domain; the console site is console.<domain>.
DSH_BASE_DOMAIN=dsh.example.com

# Optional: override image tags / network names / published ports.
# DSH_API_IMAGE=dsh-console-api:dev
# DSH_WEB_IMAGE=dsh-console-web:dev
# DSH_HTTP_PORT=38080
# DSH_API_PORT=38000