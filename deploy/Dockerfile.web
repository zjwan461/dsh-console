# Build the Vue SPA, then serve it from the same Caddy that terminates TLS and
# proxies /api. No nginx layer (see docs/02 §5).
FROM node:22-alpine AS build
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM caddy:2.9-alpine
COPY --from=build /web/dist /srv/console-web
COPY deploy/Caddyfile /etc/caddy/Caddyfile
