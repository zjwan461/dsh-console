{
  admin 0.0.0.0:2019
  auto_https disable_redirects
}

# M1: the console site only. Per-user instance routes are generated by the
# control plane in M2 (docs/02 §5); they will be added as explicit host routes
# ahead of a wildcard 404 fallback.
{$CONSOLE_DOMAIN} {
  tls internal
  encode zstd gzip

  handle /api/* {
    reverse_proxy console-api:8000 {
      flush_interval -1
    }
  }

  handle /ws/* {
    reverse_proxy console-api:8000
  }

  handle {
    root * /srv/console-web
    try_files {path} /index.html
    file_server
  }

  log {
    output stdout
    format json
  }
}
