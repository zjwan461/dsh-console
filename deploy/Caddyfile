{
  admin 0.0.0.0:2019
  auto_https disable_redirects
}

# Bootstrap config only. Once console-api is healthy it POSTs a generated config
# to the admin endpoint, replacing this file's routes with:
#   console site -> /api,/ws -> console-api; per-user hosts -> dsh-u-{id}:3080
#   (or the wake page); wildcard catch-all -> 404.
# Keeping this file means the console still answers if the API is down.
{$CONSOLE_DOMAIN} {
  tls internal
  encode zstd gzip

  handle /api/* {
    reverse_proxy console-api:8000 {
      flush_interval -1
    }
  }

  handle /ws/* {
    reverse_proxy console-api:8000
  }

  handle {
    root * /srv/console-web
    try_files {path} /index.html
    file_server
  }

  log {
    output stdout
    format json
  }
}
