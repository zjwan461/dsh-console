# Normalize line endings. Shell scripts and container build files MUST stay LF:
# a CRLF entrypoint.sh fails inside the Linux container with "/bin/sh^M".
* text=auto

.gitattributes  text eol=lf
*.sh            text eol=lf
Dockerfile*     text eol=lf
*.dockerignore  text eol=lf
*.py            text eol=lf
*.toml          text eol=lf
*.ini           text eol=lf
*.mako          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.ts            text eol=lf
*.vue           text eol=lf
*.css           text eol=lf
*.html          text eol=lf
Caddyfile       text eol=lf
.env.example    text eol=lf
