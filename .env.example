# ── 基础 ──────────────────────────────────────────────────────────────
CONSOLE_BASE_DOMAIN=dsh.example.com
CONSOLE_DOMAIN=console.dsh.example.com
CONSOLE_HTTPS_PORT=443
CONSOLE_NAME=优墨云舱
ENV=prod
LOG_LEVEL=INFO

# TLS: internal_ca (default, offline). acme is wired in M2 together with dynamic routes.
CONSOLE_TLS_MODE=internal_ca

# ── 安全（必须改；MASTER_KEY 丢失会导致已存的模型 Key 无法解密）──────────
# 生成：python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SESSION_SECRET=change-me-please-32-bytes-minimum
MASTER_KEY=

# 首次启动且 users 表为空时创建管理员；生产环境必须设置密码
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# 生产必须是 true（HTTPS）；本地 http://127.0.0.1 调试时设为 false
COOKIE_SECURE=true

# ── MySQL ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=dsh_console
MYSQL_USER=dsh
MYSQL_PASSWORD=change-me-dsh

# ── 容量准入（探测值，不是机型配置）────────────────────────────────────
MEMORY_RESERVE_MB=4096
MEMORY_RESERVE_PERCENT=10
CPU_OVERCOMMIT=4.0
DISK_USE_RATIO=0.90

# ── 实例运行时（M2）──────────────────────────────────────────────────
INSTANCE_NETWORK=dsh-edge
INSTANCE_UID=1000
INSTANCE_GID=1000
# 项目不在 /srv/dsh-console 时，必须改成宿主上 ./data 的绝对路径
HOST_DATA_ROOT=/srv/dsh-console/data

# ── worker / 计量（M3）────────────────────────────────────────────────
STATS_INTERVAL_SECONDS=30
USAGE_FLUSH_SECONDS=60
IDLE_CHECK_SECONDS=60
NODE_METRICS_ENABLED=1
CADDY_ACCESS_LOG_ENABLED=1

# ── Docker 超时（大镜像）──────────────────────────────────────────────
# 默认 HTTP 超时；commit/pull 单独放宽（2GB / 28 层的镜像 commit 会超过 30s）
DOCKER_TIMEOUT=300
DOCKER_COMMIT_TIMEOUT=1800
DOCKER_PULL_TIMEOUT=3600

# 下面几项由 compose 固定，列在这里是为了说明：
# DATA_ROOT=/srv/dsh-console/data
# DOCKER_HOST=unix:///var/run/docker.sock
# CADDY_ADMIN_URL=http://console-web:2019
# PUBLIC_SCHEME=https

# ── 本地开发（不用 Docker / MySQL / Redis）────────────────────────────
# 见 README「本地开发」：uvicorn + SQLite + fakeredis + DOCKER_FAKE=1。
